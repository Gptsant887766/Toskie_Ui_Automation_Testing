<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Dedicated suite: run ONLY LoginTestCases.
     Execute: mvn test -Dsuite.xml.file=testng-login.xml -B -->
<suite name="Login Test Suite" parallel="none" thread-count="1" verbose="2">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Login Tests">
        <classes>
            <class name="com.toskie.LoginTestCases"/>
        </classes>
    </test>

</suite>
