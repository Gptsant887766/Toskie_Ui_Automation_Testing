<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Full Regression Suite: All functional tests. Parallel by methods. -->
<suite name="Toskie Regression Suite" parallel="methods" thread-count="4" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Onboarding &amp; Login">
        <classes>
            <class name="com.toskie.tests.regression.LoginTests"/>
        </classes>
    </test>

    <test name="Profile Creation">
        <classes>
            <class name="com.toskie.tests.regression.ProfileTests"/>
        </classes>
    </test>

    <test name="Home &amp; Discovery">
        <classes>
            <class name="com.toskie.tests.regression.HomeTests"/>
        </classes>
    </test>

    <test name="Search">
        <classes>
            <class name="com.toskie.tests.regression.SearchTests"/>
        </classes>
    </test>

    <test name="Booking">
        <classes>
            <class name="com.toskie.tests.regression.BookingTests"/>
        </classes>
    </test>

    <test name="Chat">
        <classes>
            <class name="com.toskie.tests.regression.ChatTests"/>
        </classes>
    </test>

    <test name="Notifications">
        <classes>
            <class name="com.toskie.tests.regression.NotificationTests"/>
        </classes>
    </test>

    <test name="Settings">
        <classes>
            <class name="com.toskie.tests.regression.SettingsTests"/>
        </classes>
    </test>

    <test name="Logout">
        <classes>
            <class name="com.toskie.tests.regression.LogoutTests"/>
        </classes>
    </test>

    <test name="Negative Tests">
        <classes>
            <class name="com.toskie.tests.negative.NegativeTests"/>
        </classes>
    </test>

    <test name="Edge Cases">
        <classes>
            <class name="com.toskie.tests.edge.EdgeCaseTests"/>
        </classes>
    </test>

</suite>
