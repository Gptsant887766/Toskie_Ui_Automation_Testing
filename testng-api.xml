<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Toskie API Suite" verbose="1" parallel="classes" thread-count="3">
    <parameter name="browser" value="chromium"/>

    <test name="API Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <packages>
            <package name="com.toskie.tests.auth"/>
            <package name="com.toskie.tests.search"/>
            <package name="com.toskie.tests.dashboard"/>
            <package name="com.toskie.tests.messaging"/>
            <package name="com.toskie.tests.blog"/>
            <package name="com.toskie.tests.misc"/>
            <package name="com.toskie.tests.landing"/>
        </packages>
    </test>
</suite>
