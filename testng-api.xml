<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- API Suite: GraphQL API + WebSocket validation. No UI browser needed. -->
<suite name="Toskie API Suite" parallel="methods" thread-count="3" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="GraphQL API Validation">
        <classes>
            <class name="com.toskie.tests.api.APIValidationTests"/>
        </classes>
    </test>

    <test name="WebSocket Validation">
        <classes>
            <class name="com.toskie.tests.api.WebSocketTests"/>
        </classes>
    </test>

</suite>
