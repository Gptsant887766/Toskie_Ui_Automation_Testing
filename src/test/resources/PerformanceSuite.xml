<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  PERFORMANCE SUITE — Core Web Vitals and SLA Benchmarks         ║
  ║  Purpose : Enforce page load and API response time SLAs         ║
  ║  Scope   : All 13 performance tests (TC-PF-001 to TC-PF-013)    ║
  ║  Runtime : ~30–45 minutes                                       ║
  ║  Trigger : Before release; run with -Dheadless=true for baselines║
  ║  SLA     : PAGE_LOAD=5000ms, API=2000ms, FCP=2500ms, DCL=3000ms ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/PerformanceSuite.xml -Dheadless=true ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Performance Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. Core Web Vitals (TC-PF-001 to TC-PF-010) ──────────────────────── -->
    <!--
        TC-PF-001: Welcome page load <= 5000ms
        TC-PF-002: Login API response <= 2000ms
        TC-PF-003: Profile page DOM interactive <= 5000ms
        TC-PF-004: All onboarding APIs within SLA
        TC-PF-005: TTFB <= 2000ms (dev-env SLA)
        TC-PF-006: First Contentful Paint <= 5000ms (dev-env SLA)
        TC-PF-007: DOMContentLoaded <= 5000ms (dev-env SLA)
        TC-PF-008: Email OTP API response <= 6000ms
        TC-PF-009: Search results render <= 3000ms
        TC-PF-010: JS heap used < heap limit
    -->
    <test name="Performance — Core Web Vitals">
        <classes>
            <class name="com.toskie.tests.performance.PerformanceTests"/>
        </classes>
    </test>

    <!-- ── 2. API Response Time — GraphQL Layer ──────────────────────────────── -->
    <!--
        Validates that key API operations respond within 2000ms SLA.
        APIValidationTests exercises auth, profile, search, feed GraphQL endpoints.
    -->
    <test name="Performance — API Response Times">
        <classes>
            <class name="com.toskie.tests.api.APIValidationTests"/>
        </classes>
    </test>

    <!-- ── 3. Landing Page API Throughput ────────────────────────────────────── -->
    <test name="Performance — Landing Page Throughput">
        <classes>
            <class name="com.toskie.tests.landing.LandingPageApiTests"/>
        </classes>
    </test>

</suite>
