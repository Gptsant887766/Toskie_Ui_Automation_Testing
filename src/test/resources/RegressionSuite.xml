    <!-- ── 18. Smoke (final gate) ────────────────────────────────────────────── -->
    <test name="Regression — Final Smoke Gate">
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
        </classes>
    </test>

</suite>
