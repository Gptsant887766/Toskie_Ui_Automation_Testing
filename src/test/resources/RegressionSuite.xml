<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  REGRESSION SUITE — Full Functional Regression                  ║
  ║  Purpose : Catch regressions across all functional modules      ║
  ║  Scope   : All functional classes — excludes security/perf/a11y ║
  ║  Runtime : ~2–3 hours                                           ║
  ║  Trigger : After every feature branch merge to develop          ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/RegressionSuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Regression Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. Authentication ─────────────────────────────────────────────────── -->
    <test name="Regression — Authentication">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <class name="com.toskie.tests.auth.AccountRecoveryTests"/>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

    <!-- ── 2. Profile Creation Wizard ───────────────────────────────────────── -->
