<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  REGRESSION SUITE — full functional regression excluding security/accessibility/performance.
  Run after every feature branch merge to catch functional regressions.
  Use: mvn test -DsuiteXmlFile=src/test/resources/RegressionSuite.xml
-->
