<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMPONENT SUITE — Profile Module                               ║
  ║  Purpose : Targeted regression for profile creation/management  ║
  ║  Scope   : All 11 profile creation and management classes       ║
  ║  Runtime : ~25–35 minutes                                       ║
  ║  Trigger : Any change to profile wizard, gallery, bio, skills   ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/ComponentSuite_Profile.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Component — Profile" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- Profile creation wizard — step by step -->
    <test name="Profile — Step 1: Personal Info">
        <classes>
            <class name="com.toskie.tests.profile.PersonalInfoStepTests"/>
        </classes>
    </test>

    <test name="Profile — Step 2: Bio (+ AI Bio)">
        <classes>
            <class name="com.toskie.tests.profile.BioStepTests"/>
            <class name="com.toskie.tests.ai.AIBioTests"/>
        </classes>
    </test>

    <test name="Profile — Step 3: Skills">
        <classes>
            <class name="com.toskie.tests.profile.SkillStepTests"/>
        </classes>
    </test>

    <test name="Profile — Step 4: Experience">
        <classes>
            <class name="com.toskie.tests.profile.ExperienceStepTests"/>
        </classes>
    </test>

    <test name="Profile — Step 5: Qualification">
        <classes>
            <class name="com.toskie.tests.profile.QualificationStepTests"/>
        </classes>
    </test>

    <test name="Profile — Step 6: Projects">
        <classes>
            <class name="com.toskie.tests.profile.ProjectStepTests"/>
        </classes>
    </test>

    <test name="Profile — Step 7: Gallery">
        <classes>
            <class name="com.toskie.tests.profile.GalleryStepTests"/>
            <class name="com.toskie.tests.profile.GalleryManagementTests"/>
        </classes>
    </test>

    <test name="Profile — Step 8: Survey">
        <classes>
            <class name="com.toskie.tests.profile.SurveyPageTests"/>
        </classes>
    </test>

    <test name="Profile — Completion and Visibility">
        <classes>
            <class name="com.toskie.tests.profile.ProfileCompleteStatusTests"/>
            <class name="com.toskie.tests.profile.ProfileVisibilityTests"/>
        </classes>
    </test>

    <test name="Profile — Regression">
        <classes>
            <class name="com.toskie.tests.regression.ProfileTests"/>
        </classes>
    </test>

</suite>
