<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  SANITY SUITE — Post-Deployment Verification                    ║
  ║  Purpose : Quick check that all major modules work after deploy ║
  ║  Scope   : One critical class per module — P0 + P1 paths        ║
  ║  Runtime : ~25–35 minutes                                       ║
  ║  Trigger : After every deployment to QA / Staging environment   ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/SanitySuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Sanity Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. Core Smoke ─────────────────────────────────────────────────── -->
    <test name="Sanity — Smoke Check">
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
        </classes>
    </test>

    <!-- ── 2. Authentication Module ─────────────────────────────────────── -->
    <test name="Sanity — Authentication">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
            <class name="com.toskie.tests.regression.LogoutTests"/>
        </classes>
    </test>

    <!-- ── 3. Profile Creation Module ───────────────────────────────────── -->
    <test name="Sanity — Profile Creation">
        <classes>
            <class name="com.toskie.tests.profile.PersonalInfoStepTests"/>
            <class name="com.toskie.tests.profile.BioStepTests"/>
            <class name="com.toskie.tests.profile.SkillStepTests"/>
        </classes>
    </test>

    <!-- ── 4. Dashboard Module ───────────────────────────────────────────── -->
    <test name="Sanity — Dashboard">
        <classes>
            <class name="com.toskie.tests.dashboard.UserProfileTests"/>
            <class name="com.toskie.tests.dashboard.TalentProfileTests"/>
            <class name="com.toskie.tests.regression.HomeTests"/>
        </classes>
    </test>

    <!-- ── 5. Posts and Feed Module ─────────────────────────────────────── -->
    <test name="Sanity — Posts and Feed">
        <classes>
            <class name="com.toskie.tests.posts.FeedTests"/>
            <class name="com.toskie.tests.posts.AddPostTests"/>
            <class name="com.toskie.tests.posts.ExploreTests"/>
        </classes>
    </test>

    <!-- ── 6. Search Module ──────────────────────────────────────────────── -->
    <test name="Sanity — Search">
        <classes>
            <class name="com.toskie.tests.search.TalentSearchUITests"/>
            <class name="com.toskie.tests.regression.SearchTests"/>
        </classes>
    </test>

    <!-- ── 7. Messaging Module ───────────────────────────────────────────── -->
    <test name="Sanity — Messaging">
        <classes>
            <class name="com.toskie.tests.messaging.MessageRequestTests"/>
            <class name="com.toskie.tests.regression.ChatTests"/>
        </classes>
    </test>

    <!-- ── 8. API Health Check ───────────────────────────────────────────── -->
    <test name="Sanity — API">
        <classes>
            <class name="com.toskie.tests.api.APIValidationTests"/>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

    <!-- ── 9. Notifications and Activity ────────────────────────────────── -->
    <test name="Sanity — Notifications and Activity">
        <classes>
            <class name="com.toskie.tests.notifications.NotificationTests"/>
            <class name="com.toskie.tests.activity.ActivityHistoryTests"/>
        </classes>
    </test>

    <!-- ── 10. Reviews Module ────────────────────────────────────────────── -->
    <test name="Sanity — Reviews">
        <classes>
            <class name="com.toskie.tests.reviews.ReviewTests"/>
        </classes>
    </test>

    <!-- ── 11. Subscription and Settings ────────────────────────────────── -->
    <test name="Sanity — Subscription and Settings">
        <classes>
            <class name="com.toskie.tests.subscription.SubscriptionTests"/>
            <class name="com.toskie.tests.regression.SettingsTests"/>
        </classes>
    </test>

</suite>
