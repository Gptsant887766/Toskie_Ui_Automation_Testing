<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMPONENT SUITE — Dashboard Module                             ║
  ║  Purpose : Targeted regression for dashboard and talent profile ║
  ║  Scope   : 12 dashboard classes + reviews + misc dashboard APIs ║
  ║  Runtime : ~25–35 minutes                                       ║
  ║  Trigger : Any change to dashboard, profile API, CRUD ops       ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/ComponentSuite_Dashboard.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Component — Dashboard" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <test name="Dashboard — User and Talent Profile">
        <classes>
            <class name="com.toskie.tests.dashboard.UserProfileTests"/>
            <class name="com.toskie.tests.dashboard.TalentProfileTests"/>
            <class name="com.toskie.tests.dashboard.TalentProfileApiTests"/>
        </classes>
    </test>

    <test name="Dashboard — About and CRUD">
        <classes>
            <class name="com.toskie.tests.dashboard.DashboardAboutTests"/>
            <class name="com.toskie.tests.dashboard.DashboardCRUDTests"/>
            <class name="com.toskie.tests.dashboard.UpdateProfilePhotoTests"/>
        </classes>
    </test>

    <test name="Dashboard — Skills, Projects, Gallery APIs">
        <classes>
            <class name="com.toskie.tests.dashboard.SkillsApiTests"/>
            <class name="com.toskie.tests.dashboard.ProjectsApiTests"/>
            <class name="com.toskie.tests.dashboard.GalleryApiTests"/>
        </classes>
    </test>

    <test name="Dashboard — Social Features">
        <classes>
            <class name="com.toskie.tests.dashboard.ReviewDashboardTests"/>
            <class name="com.toskie.tests.dashboard.ShareProfileTests"/>
            <class name="com.toskie.tests.dashboard.OpenToConnectTests"/>
        </classes>
    </test>

    <test name="Dashboard — Reviews">
        <classes>
            <class name="com.toskie.tests.reviews.ReviewTests"/>
        </classes>
    </test>

    <test name="Dashboard — Misc View APIs">
        <classes>
            <class name="com.toskie.tests.misc.GalleryViewApiTests"/>
            <class name="com.toskie.tests.misc.ProjectViewApiTests"/>
            <class name="com.toskie.tests.misc.ViewPostApiTests"/>
            <class name="com.toskie.tests.misc.ViewerListTests"/>
        </classes>
    </test>

    <test name="Dashboard — Regression">
        <classes>
            <class name="com.toskie.tests.regression.HomeTests"/>
        </classes>
    </test>

</suite>
