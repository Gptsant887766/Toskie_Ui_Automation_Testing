<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  FULL REGRESSION SUITE — covers all 94+ modern test classes across 20 modules.
  parallel="none" is intentional: the app uses WebSocket + shared QA test data,
  so sequential execution avoids token/state conflicts.
  Use -DsuiteXmlFile=src/test/resources/FullRegressionSuite.xml to run.
-->
<suite name="Toskie Full Regression Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ==================== SMOKE / P0 ==================== -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="p0"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
        </classes>
    </test>

    <!-- ==================== AUTH ==================== -->
    <test name="Auth Tests">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <class name="com.toskie.tests.auth.AccountRecoveryTests"/>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

