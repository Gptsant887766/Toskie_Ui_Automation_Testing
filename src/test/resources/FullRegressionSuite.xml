<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  FULL REGRESSION SUITE — All 93 Test Classes                    ║
  ║  Purpose : Complete test coverage including security/perf/a11y  ║
  ║  Scope   : Every test class in the framework                    ║
  ║  Runtime : ~4–5 hours                                           ║
  ║  Trigger : Weekly regression / before major release             ║
  ║  Note    : parallel="none" — WebSocket + shared QA data require ║
  ║            sequential execution to avoid state conflicts        ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/FullRegressionSuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Full Regression Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ══════════════════ MODULE 01: SMOKE ══════════════════════════════════ -->
