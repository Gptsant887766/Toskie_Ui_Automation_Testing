<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMPONENT SUITE — Authentication Module                        ║
  ║  Purpose : Targeted regression for auth module changes          ║
  ║  Scope   : Login, registration, account recovery, auth API      ║
  ║  Runtime : ~15–20 minutes                                       ║
  ║  Trigger : Any change to auth flows, OTP, JWT token handling    ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/ComponentSuite_Auth.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Component — Auth" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <test name="Auth — Login and OTP">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
        </classes>
    </test>

    <test name="Auth — Registration">
        <classes>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
        </classes>
    </test>

    <test name="Auth — Account Recovery">
        <classes>
            <class name="com.toskie.tests.auth.AccountRecoveryTests"/>
        </classes>
    </test>

    <test name="Auth — API Contract">
        <classes>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

    <test name="Auth — Login and Logout (regression)">
        <classes>
            <class name="com.toskie.tests.regression.LoginTests"/>
            <class name="com.toskie.tests.regression.LogoutTests"/>
        </classes>
    </test>

    <test name="Auth — Security (JWT and Auth Flows)">
        <classes>
            <class name="com.toskie.tests.security.JwtSecurityTests"/>
        </classes>
    </test>

</suite>
