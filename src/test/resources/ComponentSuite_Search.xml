<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMPONENT SUITE — Search and Discovery Module                  ║
  ║  Purpose : Targeted regression for search features              ║
  ║  Scope   : 4 search classes (UI, API, address, recent search)   ║
  ║  Runtime : ~10–15 minutes                                       ║
  ║  Trigger : Any change to search indexing, filters, results page ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/ComponentSuite_Search.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Component — Search" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <test name="Search — UI and Filters">
        <classes>
            <class name="com.toskie.tests.search.TalentSearchUITests"/>
        </classes>
    </test>

    <test name="Search — API">
        <classes>
            <class name="com.toskie.tests.search.TalentSearchApiTests"/>
        </classes>
    </test>

    <test name="Search — Location and Address">
        <classes>
            <class name="com.toskie.tests.search.TalentAddressSearchTests"/>
            <class name="com.toskie.tests.misc.ChangeLocationTests"/>
        </classes>
    </test>

    <test name="Search — Recent Search History">
        <classes>
            <class name="com.toskie.tests.search.DeleteRecentSearchTests"/>
        </classes>
    </test>

    <test name="Search — Regression">
        <classes>
            <class name="com.toskie.tests.regression.SearchTests"/>
        </classes>
    </test>

</suite>
