<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  API REGRESSION SUITE — GraphQL and REST API Validation         ║
  ║  Purpose : Validate all API endpoints without browser UI        ║
  ║  Scope   : All API test classes — contract + response + auth    ║
  ║  Runtime : ~30–45 minutes                                       ║
  ║  Trigger : After backend changes or API contract updates        ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/APIRegressionSuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie API Regression Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. Core API Validation ────────────────────────────────────────────── -->
    <!--  GraphQL operations: auth, profile, feed, search, messaging endpoints  -->
    <test name="API — Core GraphQL Validation">
        <classes>
            <class name="com.toskie.tests.api.APIValidationTests"/>
        </classes>
    </test>

    <!-- ── 2. Authentication API ────────────────────────────────────────────── -->
    <!--  QA bypass login, OTP verification, token lifecycle                   -->
    <test name="API — Authentication">
        <classes>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

    <!-- ── 3. Landing Page API ──────────────────────────────────────────────── -->
    <!--  Landing page content, discovery API, public endpoints                -->
    <test name="API — Landing Page">
        <classes>
            <class name="com.toskie.tests.landing.LandingPageApiTests"/>
        </classes>
    </test>

    <!-- ── 4. Talent Profile APIs ───────────────────────────────────────────── -->
    <!--  Profile fetch, update, skills, projects, gallery APIs                -->
    <test name="API — Talent Profile">
        <classes>
            <class name="com.toskie.tests.dashboard.TalentProfileApiTests"/>
            <class name="com.toskie.tests.dashboard.SkillsApiTests"/>
            <class name="com.toskie.tests.dashboard.ProjectsApiTests"/>
            <class name="com.toskie.tests.dashboard.GalleryApiTests"/>
        </classes>
    </test>

    <!-- ── 5. Search API ─────────────────────────────────────────────────────── -->
    <!--  Talent search, address search, filter APIs                           -->
    <test name="API — Search">
        <classes>
            <class name="com.toskie.tests.search.TalentSearchApiTests"/>
        </classes>
    </test>

    <!-- ── 6. Blog API ──────────────────────────────────────────────────────── -->
    <!--  Blog listing, pagination, category filter, post count                -->
    <test name="API — Blog">
        <classes>
            <class name="com.toskie.tests.blog.BlogApiTests"/>
        </classes>
    </test>

    <!-- ── 7. Misc View APIs ────────────────────────────────────────────────── -->
    <!--  Gallery view, project view, post view API endpoints                  -->
    <test name="API — Misc View APIs">
        <classes>
            <class name="com.toskie.tests.misc.GalleryViewApiTests"/>
            <class name="com.toskie.tests.misc.ProjectViewApiTests"/>
            <class name="com.toskie.tests.misc.ViewPostApiTests"/>
        </classes>
    </test>

    <!-- ── 8. WebSocket API ──────────────────────────────────────────────────── -->
    <!--  WebSocket connection, messaging, bulk read, timezone                  -->
    <test name="API — WebSocket">
        <classes>
            <class name="com.toskie.tests.api.WebSocketTests"/>
            <class name="com.toskie.tests.websocket.WebSocketConnectionTests"/>
            <class name="com.toskie.tests.websocket.WebSocketMessageTests"/>
            <class name="com.toskie.tests.websocket.BulkMessageReadTests"/>
            <class name="com.toskie.tests.websocket.TimezoneWebSocketTests"/>
        </classes>
    </test>

    <!-- ── 9. Messaging Fetch APIs ──────────────────────────────────────────── -->
    <!--  Fetch message requests, conversation list, calls, similar talents     -->
    <test name="API — Messaging Fetch">
        <classes>
            <class name="com.toskie.tests.messaging.FetchRequestsTests"/>
            <class name="com.toskie.tests.messaging.CallListingsTests"/>
            <class name="com.toskie.tests.messaging.SimilarTalentsTests"/>
            <class name="com.toskie.tests.messaging.ValidateTalentTests"/>
        </classes>
    </test>

</suite>
