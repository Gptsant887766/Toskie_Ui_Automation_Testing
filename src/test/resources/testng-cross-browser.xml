<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ==================== CHROME ==================== -->
    <test name="Smoke Tests - Chrome">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="smoke"/>
                <include name="p0"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
        </classes>
    </test>

    <!-- ==================== FIREFOX ==================== -->
    <test name="Smoke Tests - Firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="smoke"/>
                <include name="p0"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
        </classes>
    </test>

    <!-- ==================== WEBKIT (Safari) ==================== -->
    <test name="Smoke Tests - WebKit">
        <parameter name="browser" value="webkit"/>
        <groups>
            <run>
                <include name="smoke"/>
                <include name="p0"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
        </classes>
    </test>

</suite>
