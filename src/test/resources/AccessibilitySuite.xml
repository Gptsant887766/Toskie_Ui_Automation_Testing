<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  ACCESSIBILITY SUITE — WCAG 2.1 AA Compliance                   ║
  ║  Purpose : Validate accessibility across all major pages        ║
  ║  Scope   : axe-core WCAG 2.1 AA + keyboard nav + screen reader  ║
  ║  Runtime : ~30–45 minutes                                       ║
  ║  Trigger : Before every release; must pass on staging           ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/AccessibilitySuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Accessibility Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. WCAG 2.1 AA — Full axe-core Audit ─────────────────────────────── -->
    <!--
        AccessibilityTests contains all axe-core scans:
          TC-ACC-001: Landing/welcome page WCAG audit
          TC-ACC-002: Login flow WCAG audit
          TC-ACC-003: Profile creation page WCAG audit
          TC-ACC-004: Color contrast ratio check
          TC-ACC-005: Alt text on images
          TC-ACC-006: Form label associations
          TC-ACC-007: ARIA roles and landmarks
          TC-ACC-008: Heading hierarchy (h1→h2→h3)
          TC-ACC-009: Keyboard-only navigation (Tab/Enter)
          TC-ACC-010: Focus visible indicators
          TC-ACC-011: Screen reader announcements
          TC-ACC-012: Touch target sizes (>= 44x44px)
    -->
    <test name="Accessibility — Full WCAG 2.1 AA Audit">
        <classes>
            <class name="com.toskie.tests.accessibility.AccessibilityTests"/>
        </classes>
    </test>

    <!-- ── 2. Privacy Policy Readability ────────────────────────────────────── -->
    <test name="Accessibility — Legal Pages">
        <classes>
            <class name="com.toskie.tests.misc.PrivacyPolicyTests"/>
        </classes>
    </test>

</suite>
