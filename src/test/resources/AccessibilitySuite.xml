<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ACCESSIBILITY SUITE — WCAG 2.1 compliance, keyboard navigation, screen reader.
  Run before every release against staging environment.
  Use: mvn test -DsuiteXmlFile=src/test/resources/AccessibilitySuite.xml
-->
<suite name="Toskie Accessibility Suite" verbose="1" parallel="none">

    <test name="Accessibility Audit">
        <groups>
            <run>
                <include name="accessibility"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.accessibility.AccessibilityTests"/>
        </classes>
    </test>

    <test name="Landing and Auth Accessibility">
        <groups>
            <run>
                <include name="accessibility"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
        </classes>
    </test>

    <test name="Dashboard Accessibility">
        <groups>
            <run>
                <include name="accessibility"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.dashboard.UserProfileTests"/>
            <class name="com.toskie.tests.dashboard.TalentProfileTests"/>
        </classes>
    </test>

    <test name="Navigation Accessibility">
        <groups>
            <run>
                <include name="accessibility"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.misc.PrivacyPolicyTests"/>
        </classes>
    </test>

</suite>
