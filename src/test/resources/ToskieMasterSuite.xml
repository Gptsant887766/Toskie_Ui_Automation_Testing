<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  TOSKIE MASTER SUITE — Single TestNG XML (IDE use)              ║
  ║  Purpose : Right-click → Run As TestNG Suite in Eclipse/IntelliJ║
  ║  Scope   : All 93 classes across all 21 modules — no filter     ║
  ║  Runtime : ~4–5 hours (thread-count=10)                         ║
  ║                                                                  ║
  ║  CI/Maven: Groups are controlled by Maven profiles, NOT this XML ║
  ║    mvn test -Pdev   → groups=smoke   (thread=5)                 ║
  ║    mvn test -Pqa    → groups=regression (thread=10)             ║
  ║    mvn test -Pstage → all groups (no filter, thread=10)         ║
  ║    mvn test -Pprod  → groups=smoke   (thread=5)                 ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Master Suite" verbose="1" parallel="classes" thread-count="10" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
        <listener class-name="com.toskie.listeners.ExecutionListener"/>
        <listener class-name="com.toskie.listeners.SuiteListener"/>
        <listener class-name="com.toskie.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- MODULE 01 — SMOKE -->
    <test name="01 — Smoke">
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
        </classes>
    </test>

    <!-- MODULE 02 — AUTHENTICATION -->
    <test name="02 — Authentication">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <class name="com.toskie.tests.auth.AccountRecoveryTests"/>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
        </classes>
    </test>

    <!-- MODULE 03 — PROFILE CREATION -->
