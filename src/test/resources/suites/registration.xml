<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔═══════════════════════════════════════════════════════════════════════╗
  ║  REGISTRATION SUITE                                                   ║
  ║  Scope   : All registration flows — new user, new talent, OTP,       ║
  ║            form validations, API payload verification                 ║
  ║  Excluded: This class does NOT appear in Smoke, Sanity, or Regression ║
  ║  Thread  : 2 parallel classes (registration is state-sensitive)       ║
  ║  Runtime : ~15-20 minutes                                             ║
  ║  Trigger : Registration feature changes | Auth pipeline verification  ║
  ╚═══════════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie — Registration Suite" verbose="1"
       parallel="classes" thread-count="2"
       data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
        <listener class-name="com.toskie.listeners.ExecutionListener"/>
        <listener class-name="com.toskie.listeners.SuiteListener"/>
        <listener class-name="com.toskie.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- Registration Flows -->
    <test name="Registration — All Scenarios" preserve-order="false">
        <classes>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
        </classes>
    </test>

</suite>
