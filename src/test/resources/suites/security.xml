<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔═══════════════════════════════════════════════════════════════════════╗
  ║  SECURITY SUITE                                                       ║
  ║  Filter  : @Test(groups = {"security"}) — 17 methods                 ║
  ║  Classes : SecurityTests, JwtSecurityTests, IdorTests                 ║
  ║  Thread  : 3 parallel classes (sequential within each class)          ║
  ║  Runtime : ~15–20 minutes                                             ║
  ║  Trigger : Weekly security scan | pre-release gate                   ║
  ║  Env     : Any → mvn test -Pqa -DsuiteXmlFile=suites/security.xml    ║
  ║  IDE     : Right-click → Run As TestNG Suite                          ║
  ╚═══════════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie — Security Suite" verbose="1"
       parallel="classes" thread-count="3"
       data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
        <listener class-name="com.toskie.listeners.ExecutionListener"/>
        <listener class-name="com.toskie.listeners.SuiteListener"/>
        <listener class-name="com.toskie.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!--
      Uses group filter — only @Test(groups={"security"}) methods run.
      SecurityTests (JWT bypass), JwtSecurityTests (token validation),
      IdorTests (IDOR checks) all carry the "security" group annotation.
    -->
    <test name="Security — JWT, IDOR and Token Validation" preserve-order="true">
        <groups>
            <run>
                <include name="security"/>
            </run>
        </groups>
        <packages>
            <package name="com.toskie.tests.security"/>
        </packages>
    </test>

</suite>
