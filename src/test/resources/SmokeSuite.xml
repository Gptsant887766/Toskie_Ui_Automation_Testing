<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  SMOKE SUITE — Build Verification                               ║
  ║  Purpose : Verify the build is deployable. Run on every commit. ║
  ║  Scope   : Critical P0 paths — auth, home, feed, post creation  ║
  ║  Runtime : ~10–15 minutes                                       ║
  ║  Trigger : Every CI build / pre-deploy gate                     ║
  ║  Command : mvn test -DsuiteXmlFile=src/test/resources/SmokeSuite.xml ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie Smoke Suite" verbose="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
    </listeners>

    <!-- ── 1. Core smoke scenarios (login, OTP, home, profile) ─────────── -->
    <test name="Smoke — Core Platform">
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
        </classes>
    </test>

    <!-- ── 2. Authentication ─────────────────────────────────────────────── -->
    <test name="Smoke — Authentication">
        <classes>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
            <class name="com.toskie.tests.regression.LogoutTests"/>
        </classes>
    </test>

    <!-- ── 3. Home and Feed ──────────────────────────────────────────────── -->
    <test name="Smoke — Home and Feed">
        <classes>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.posts.FeedTests"/>
        </classes>
    </test>

    <!-- ── 4. Post Creation ──────────────────────────────────────────────── -->
    <test name="Smoke — Post Creation">
        <classes>
            <class name="com.toskie.tests.posts.AddPostTests"/>
        </classes>
    </test>

    <!-- ── 5. Landing Page ───────────────────────────────────────────────── -->
    <test name="Smoke — Landing Page">
        <classes>
            <class name="com.toskie.tests.landing.LandingPageApiTests"/>
        </classes>
    </test>

</suite>
