<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Toskie Smoke Suite" verbose="1" parallel="methods" thread-count="2">
    <parameter name="browser" value="chrome"/>

    <test name="Smoke Tests - P0">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="p0"/>
            </run>
        </groups>
        <packages>
            <package name="com.toskie.tests.auth"/>
            <package name="com.toskie.tests.landing"/>
            <package name="com.toskie.tests.dashboard"/>
            <package name="com.toskie.tests.messaging"/>
            <package name="com.toskie.tests.posts"/>
            <package name="com.toskie.tests.search"/>
        </packages>
    </test>
</suite>

