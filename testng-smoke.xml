<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Smoke Suite: Critical happy-path tests only. Run on every deployment. -->
<suite name="Toskie Smoke Suite" parallel="none" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Smoke - Onboarding">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
        </classes>
    </test>

</suite>
