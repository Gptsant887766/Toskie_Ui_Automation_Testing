<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="none"  → all test methods run sequentially on a single thread.
  Profile creation tests each launch a full browser + 40s flow; running them
  concurrently (parallel="methods") saturates CPU/network and causes
  Timeout 60000ms / ERR_NETWORK_IO_SUSPENDED failures.

  BrowserManager, ApiUtils, and ReportManager are all ThreadLocal-safe and
  can support parallel="tests" if machine resources allow in the future.
-->
<suite name="Toskie Suite" parallel="none" thread-count="1" verbose="2">

    <test name="Welcome Page Tests">
        <classes>
            <class name="com.toskie.WelcomePageTestCases"/>
        </classes>
    </test>

    <test name="Welcome Landing Test">
        <classes>
            <class name="com.toskie.WelcomeToToskieLandingTestCase"/>
        </classes>
        
    </test>

    <test name="Login Test">
        <classes>
            <class name="com.toskie.LoginTestCases"/>
        </classes>
    </test>

    <test name="Login Page Tests">
        <classes>
            <class name="com.toskie.LoginPageTestCases"/>
        </classes>
    </test>

    <test name="Create Profile Test">
        <classes>
            <class name="com.toskie.ToskieCreatePrifileTestCases"/>
        </classes>
    </test>

    <test name="Profile Creation Tests">
        <classes>
            <class name="com.toskie.ProfileCreationTestCases"/>
        </classes>
    </test>

    <test name="End-to-End Flow Tests">
        <classes>
            <class name="com.toskie.EndToEndFlowTestCases"/>
        </classes>
    </test>

</suite>
