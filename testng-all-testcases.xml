<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ALL TOSKIE TEST CASES SUITE
  Runs AllToskieTestCases.java — 125 tests mapped 1-to-1 with
  Toskie_Web_Desktop_TestCases.csv (automated entries only).

  Run full suite:
      mvn clean test -Dsuite.xml.file=testng-all-testcases.xml

  Run a single group (e.g. smoke only):
      mvn clean test -Dsuite.xml.file=testng-all-testcases.xml -Dgroups=smoke

  Available groups: smoke | onboarding | login | profile | home | search
                    booking | chat | notifications | settings | logout
                    security | performance | accessibility | e2e | negative | edge
-->
<suite name="All Toskie Test Cases" parallel="none" thread-count="1" verbose="2">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <!-- ===== Onboarding ===== -->
    <test name="Onboarding Tests">
        <groups>
            <run><include name="onboarding"/></run>
        </groups>
        <classes>
            <class name="com.toskie.AllToskieTestCases"/>
        </classes>
    </test>

    <!-- ===== Login ===== -->
    <test name="Login Tests">
        <groups>
            <run><include name="login"/></run>
        </groups>
        <classes>
            <class name="com.toskie.AllToskieTestCases"/>
        </classes>
    </test>

    <!-- ===== Profile Creation ===== -->
