<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════════════════════╗
  ║  TESTER EXECUTION SUITE  — Master Control File                              ║
  ║                                                                              ║
  ║  Usage: Enable exactly ONE <test> block by setting enabled="true".          ║
  ║         Set all others to enabled="false".                                   ║
  ║                                                                              ║
  ║  Run command:  mvn test -DsuiteXmlFile=TesterExecutionSuite.xml              ║
  ║                                                                              ║
  ║  Available Suites:                                                           ║
  ║    1. Smoke Suite      — P0 gate, ~5–8 min,   groups=smoke                  ║
  ║    2. Sanity Suite     — Core platform, ~20–30 min                           ║
  ║    3. Regression Suite — All functional, ~2.5–3 hrs                         ║
  ║    4. End-to-End Suite — Full user journeys, ~30–45 min                     ║
  ║    5. Master Suite     — All 93 classes, ~4–5 hrs                           ║
  ╚══════════════════════════════════════════════════════════════════════════════╝
-->
<suite name="Toskie — Tester Execution Suite" verbose="1"
       parallel="classes" thread-count="3"
       data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.toskie.utils_Layer.RetryTransformer"/>
        <listener class-name="com.toskie.listeners.ExecutionListener"/>
        <listener class-name="com.toskie.listeners.SuiteListener"/>
        <listener class-name="com.toskie.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- ═══════════════════════════════════════════════════════════════
         SUITE 1 — SMOKE  (enabled="true" to run)
         P0 gate: fastest CI check — smoke-tagged tests only
         Runtime: ~5–8 minutes | Trigger: every commit / every PR
         Note: Uses explicit class list + group filter (package scan
               does not resolve smoke group correctly with Surefire 3.2.5)
         ═══════════════════════════════════════════════════════════════ -->
    <test name="1 — Smoke Suite" enabled="true" preserve-order="false">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.toskie.tests.smoke.SmokeTests"/>
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <class name="com.toskie.tests.auth.AccountRecoveryTests"/>
            <class name="com.toskie.tests.auth.AuthApiTests"/>
            <class name="com.toskie.tests.dashboard.UserProfileTests"/>
            <class name="com.toskie.tests.dashboard.TalentProfileTests"/>
            <class name="com.toskie.tests.posts.FeedTests"/>
            <class name="com.toskie.tests.posts.AddPostTests"/>
            <class name="com.toskie.tests.profile.PersonalInfoStepTests"/>
            <class name="com.toskie.tests.profile.BioStepTests"/>
            <class name="com.toskie.tests.profile.ExperienceStepTests"/>
            <class name="com.toskie.tests.regression.HomeTests"/>
            <class name="com.toskie.tests.regression.LoginTests"/>
            <class name="com.toskie.tests.search.TalentSearchUITests"/>
            <class name="com.toskie.tests.search.TalentSearchApiTests"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         SUITE 2 — SANITY  (enabled="false" — switch to true to run)
         Core platform: smoke + auth + dashboard + search
         Runtime: ~20–30 minutes | Trigger: post-deployment
         ═══════════════════════════════════════════════════════════════ -->
    <test name="2 — Sanity Suite" enabled="false" preserve-order="false">
        <packages>
            <package name="com.toskie.tests.smoke"/>
            <package name="com.toskie.tests.auth"/>
            <package name="com.toskie.tests.dashboard"/>
            <package name="com.toskie.tests.search"/>
        </packages>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         SUITE 3 — REGRESSION  (enabled="false" — switch to true to run)
         All functional modules excluding websocket + performance
         Runtime: ~2.5–3 hours | Trigger: nightly / feature merge
         ═══════════════════════════════════════════════════════════════ -->
    <test name="3 — Regression Suite" enabled="false" preserve-order="false">
        <packages>
            <package name="com.toskie.tests.smoke"/>
            <package name="com.toskie.tests.auth"/>
            <package name="com.toskie.tests.profile"/>
            <package name="com.toskie.tests.dashboard"/>
            <package name="com.toskie.tests.posts"/>
            <package name="com.toskie.tests.search"/>
            <package name="com.toskie.tests.messaging"/>
            <package name="com.toskie.tests.api"/>
            <package name="com.toskie.tests.landing"/>
            <package name="com.toskie.tests.blog"/>
            <package name="com.toskie.tests.reviews"/>
            <package name="com.toskie.tests.activity"/>
            <package name="com.toskie.tests.notifications"/>
            <package name="com.toskie.tests.ai"/>
            <package name="com.toskie.tests.subscription"/>
            <package name="com.toskie.tests.regression"/>
            <package name="com.toskie.tests.misc"/>
            <package name="com.toskie.tests.negative"/>
            <package name="com.toskie.tests.edge"/>
            <package name="com.toskie.tests.security"/>
            <package name="com.toskie.tests.accessibility"/>
        </packages>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         SUITE 4 — END-TO-END  (enabled="false" — switch to true to run)
         Full user journeys: login → profile → post → search → E2E
         Runtime: ~30–45 minutes | Trigger: release candidate validation
         ═══════════════════════════════════════════════════════════════ -->
    <test name="4 — End-to-End Suite" enabled="false" preserve-order="true">
        <classes>
            <!-- Authentication Entry Points -->
            <class name="com.toskie.tests.auth.AuthLoginTests"/>
            <class name="com.toskie.tests.auth.RegistrationTests"/>
            <!-- Profile Journey -->
            <class name="com.toskie.tests.profile.PersonalInfoStepTests"/>
            <class name="com.toskie.tests.profile.BioStepTests"/>
            <class name="com.toskie.tests.profile.SkillStepTests"/>
            <class name="com.toskie.tests.profile.ExperienceStepTests"/>
            <class name="com.toskie.tests.profile.QualificationStepTests"/>
            <class name="com.toskie.tests.profile.GalleryStepTests"/>
            <!-- Dashboard & Social -->
            <class name="com.toskie.tests.dashboard.UserProfileTests"/>
            <class name="com.toskie.tests.dashboard.DashboardAboutTests"/>
            <class name="com.toskie.tests.posts.FeedTests"/>
            <class name="com.toskie.tests.posts.AddPostTests"/>
            <class name="com.toskie.tests.posts.TextPostTests"/>
            <!-- Search & Discovery -->
            <class name="com.toskie.tests.search.TalentSearchUITests"/>
            <class name="com.toskie.tests.search.TalentSearchApiTests"/>
            <!-- Messaging -->
            <class name="com.toskie.tests.messaging.MessageRequestTests"/>
            <class name="com.toskie.tests.messaging.ConversationListTests"/>
            <!-- End-to-End Flows -->
            <class name="com.toskie.tests.e2e.EndToEndTests"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         SUITE 5 — MASTER  (enabled="false" — switch to true to run)
         All 93 test classes, all 21 modules, no filter
         Runtime: ~4–5 hours | Trigger: release sign-off
         ═══════════════════════════════════════════════════════════════ -->
