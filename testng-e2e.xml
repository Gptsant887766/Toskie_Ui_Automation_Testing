<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- End-to-End Suite: Full user journeys spanning multiple modules. Sequential. -->
<suite name="Toskie E2E Suite" parallel="none" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="End-to-End Journeys">
        <classes>
            <class name="com.toskie.tests.e2e.EndToEndTests"/>
        </classes>
    </test>

</suite>
