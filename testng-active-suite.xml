<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ACTIVE SUITE — all 7 active test classes, 46 tests total.
  Runs sequentially (parallel="none") — tests share one browser via BrowserManager.
  Produces a single ExtentReports HTML + PDF in Reports/HTML/ and Reports/PDF/.

  Run: mvn clean test -Dsuite.xml.file=testng-active-suite.xml -B
-->
<suite name="Toskie Active Test Suite" parallel="none" thread-count="1" verbose="2">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <!-- 1. Welcome / Onboarding (basic) -->
    <test name="Welcome Landing">
        <classes>
            <class name="com.toskie.WelcomeToToskieLandingTestCase"/>
        </classes>
    </test>

    <!-- 2. Welcome Page (TC-WP-001..008) -->
    <test name="Welcome Page">
        <classes>
            <class name="com.toskie.WelcomePageTestCases"/>
        </classes>
    </test>

    <!-- 3. Login Flow (basic complete-flow + data-driven) -->
    <test name="Login Flow">
        <classes>
            <class name="com.toskie.LoginTestCases"/>
        </classes>
    </test>

    <!-- 4. Login Page (TC-LG-001..012 — token, storage, navigation) -->
    <test name="Login Page">
        <classes>
            <class name="com.toskie.LoginPageTestCases"/>
        </classes>
    </test>

    <!-- 5. Profile Creation (simple single test) -->
    <test name="Create Profile Simple">
        <classes>
            <class name="com.toskie.ToskieCreatePrifileTestCases"/>
        </classes>
    </test>

    <!-- 6. Profile Creation (TC-PC-001..014 — full coverage) -->
    <test name="Profile Creation">
        <classes>
            <class name="com.toskie.ProfileCreationTestCases"/>
        </classes>
    </test>

    <!-- 7. End-to-End Flows (TC-E2E-001..006) -->
    <test name="End-to-End Flows">
        <classes>
            <class name="com.toskie.EndToEndFlowTestCases"/>
        </classes>
    </test>

</suite>
