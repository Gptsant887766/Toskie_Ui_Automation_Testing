<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Accessibility Suite: WCAG 2.1 AA compliance testing. -->
<suite name="Toskie Accessibility Suite" parallel="none" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Accessibility Tests">
        <classes>
            <class name="com.toskie.tests.accessibility.AccessibilityTests"/>
        </classes>
    </test>

</suite>
