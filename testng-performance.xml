<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Performance Suite: Core Web Vitals, page load, API response times. -->
<suite name="Toskie Performance Suite" parallel="none" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Performance Tests">
        <classes>
            <class name="com.toskie.tests.performance.PerformanceTests"/>
        </classes>
    </test>

</suite>
