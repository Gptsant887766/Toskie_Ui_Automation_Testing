<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ================= PROJECT DETAILS ================= -->

    <groupId>com.toskie</groupId>
    <artifactId>Toskie_Web_Automation_Framework</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>Toskie Playwright Automation Framework</name>

    <!-- ================= PROPERTIES ================= -->

    <properties>

        <!-- JAVA VERSION -->
        <java.version>21</java.version>

        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- ENCODING -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Suite XML — overridden by each Maven profile -->
        <suiteXmlFile>src/test/resources/ToskieMasterSuite.xml</suiteXmlFile>

        <!-- DEPENDENCY VERSIONS -->
        <playwright.version>1.53.0</playwright.version>
<testng.version>7.9.0</testng.version>
        <extent.version>5.0.9</extent.version>
        <lombok.version>1.18.38</lombok.version>
        <allure.version>2.29.0</allure.version>
        <aspectj.version>1.9.22.1</aspectj.version>

        <!-- ─── CI/CD overridable defaults ─────────────────────────────────── -->
        <!-- Override on the command line: mvn test -Pqa -Dbrowser=firefox      -->
        <!-- Or let the Maven profile set them automatically (see <profiles>)   -->
        <browser>chrome</browser>
        <headless>true</headless>
        <env>dev</env>
        <baseUrl>https://dev.app.toskie.com/</baseUrl>
        <apiUrl>https://toskie-api.wasd.in/graphql</apiUrl>
        <max.retries>3</max.retries>

    </properties>

    <!-- ================= DEPENDENCIES ================= -->

    <dependencies>

        <!-- ================================================= -->
        <!-- PLAYWRIGHT -->
        <!-- ================================================= -->

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- ================================================= -->
        <!-- TESTNG -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ================================================= -->
        <!-- EXTENT REPORT -->
        <!-- ================================================= -->

        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extent.version}</version>
        </dependency>

        <!-- ================================================= -->
        <!-- LOMBOK -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================= -->
        <!-- APACHE COMMONS IO -->
        <!-- ================================================= -->

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
        </dependency>

        <!-- ================================================= -->
        <!-- APACHE COMMONS LANG -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <!-- ================================================= -->
        <!-- JSON -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!-- ================================================= -->
        <!-- LOGGING -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>

        <!-- ================================================= -->
        <!-- PDF REPORT -->
        <!-- ================================================= -->

        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>

        <!-- ================================================= -->
        <!-- CHART REPORT -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.5.3</version>
        </dependency>

        <!-- ================================================= -->
        <!-- ITEXT PDF -->
        <!-- ================================================= -->

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>kernel</artifactId>
            <version>7.2.5</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>layout</artifactId>
            <version>7.2.5</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>io</artifactId>
            <version>7.2.5</version>
        </dependency>

        <!-- ================================================= -->
        <!-- ALLURE TESTNG INTEGRATION                        -->
        <!-- ================================================= -->

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- AspectJ weaver — enables @Step annotation processing at runtime -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- ================================================= -->
        <!-- AXE-CORE ACCESSIBILITY (Playwright) -->
        <!-- ================================================= -->

        <dependency>
            <groupId>com.deque.html.axe-core</groupId>
            <artifactId>playwright</artifactId>
            <version>4.10.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================= BUILD ================= -->

    <build>

        <plugins>

            <!-- ================================================= -->
            <!-- MAVEN COMPILER -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>

                    <source>${java.version}</source>
                    <target>${java.version}</target>

                    <compilerArgs>

                        <arg>--add-opens</arg>
                        <arg>java.base/java.lang=ALL-UNNAMED</arg>

                    </compilerArgs>

                    <!-- LOMBOK -->
                    <annotationProcessorPaths>

                        <path>

                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>

                        </path>

                    </annotationProcessorPaths>

                </configuration>

            </plugin>

            <!-- ================================================= -->
            <!-- MAVEN SUREFIRE -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>

                <configuration>

                    <!-- Suite XML is set per Maven profile; override with -DsuiteXmlFile=... -->
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>

                    <!-- JVM ARG -->
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>

                    <!-- Pass Maven profile properties + CI overrides as JVM system properties -->
                    <systemPropertyVariables>
                        <environment>${env}</environment>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                        <baseUrl>${baseUrl}</baseUrl>
                        <apiUrl>${apiUrl}</apiUrl>
                        <max.retries>${max.retries}</max.retries>
                    </systemPropertyVariables>

                </configuration>

            </plugin>

            <!-- ================================================= -->
            <!-- ALLURE MAVEN PLUGIN                             -->
            <!-- ================================================= -->

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.12.0</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                </configuration>
            </plugin>

            <!-- ================================================= -->
            <!-- EXEC MAVEN PLUGIN                                   -->
            <!-- Used to install Playwright browsers in CI:          -->
            <!--   mvn exec:java \                                   -->
            <!--     -Dexec.mainClass=com.microsoft.playwright.CLI \ -->
            <!--     -Dexec.args="install chromium"                  -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

        </plugins>

    </build>

    <!-- ==================== MAVEN PROFILES ==================== -->
    <!--
      Activate with:  mvn test -Pqa
      Each profile sets the target URLs, default suite, retry count, and env
      label. Values are forwarded to ConfigReader via <systemPropertyVariables>.
      Secrets (testMobile, testEmail, qaSecret, …) are NOT set here;
      they must come from -D flags or CI environment variables.

      Commands:
        DEV   : mvn test -Pdev
        QA    : mvn test -Pqa
        STAGE : mvn test -Pstage
        PROD  : mvn test -Pprod
    -->

    <profiles>

        <!-- ───── DEV ─────────────────────────────────────────────────────── -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
                <baseUrl>https://dev.app.toskie.com/</baseUrl>
                <apiUrl>https://toskie-api.wasd.in/graphql</apiUrl>
                <suiteXmlFile>src/test/resources/suites/smoke.xml</suiteXmlFile>
                <headless>true</headless>
                <max.retries>3</max.retries>
            </properties>
        </profile>

        <!-- ───── QA ──────────────────────────────────────────────────────── -->
        <profile>
            <id>qa</id>
            <properties>
                <env>qa</env>
                <baseUrl>https://qa.app.toskie.com/</baseUrl>
                <apiUrl>https://qa-api.toskie.wasd.in/graphql</apiUrl>
                <suiteXmlFile>src/test/resources/suites/regression.xml</suiteXmlFile>
                <headless>true</headless>
                <max.retries>2</max.retries>
            </properties>
        </profile>

        <!-- ───── STAGE ───────────────────────────────────────────────────── -->
        <profile>
            <id>stage</id>
            <properties>
                <env>stage</env>
                <baseUrl>https://stage.app.toskie.com/</baseUrl>
                <apiUrl>https://stage-api.toskie.wasd.in/graphql</apiUrl>
                <suiteXmlFile>src/test/resources/ToskieMasterSuite.xml</suiteXmlFile>
                <headless>true</headless>
                <max.retries>1</max.retries>
            </properties>
        </profile>

        <!-- ───── PROD ────────────────────────────────────────────────────── -->
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
                <baseUrl>https://app.toskie.com/</baseUrl>
                <apiUrl>https://api.toskie.com/graphql</apiUrl>
                <!-- Smoke ONLY — no destructive, write, or auth-bypass tests in PROD -->
                <suiteXmlFile>src/test/resources/suites/smoke.xml</suiteXmlFile>
                <headless>true</headless>
                <max.retries>0</max.retries>
            </properties>
        </profile>

    </profiles>

</project>