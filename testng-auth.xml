<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Focused suite: all authentication + profile creation tests.
     Run with: mvn clean test -Dsuite.xml.file=testng-auth.xml
     parallel="none" ensures tests run sequentially (one browser at a time). -->
<suite name="Auth Suite" parallel="none" thread-count="1" verbose="2">

    <test name="Welcome Page">
        <classes>
            <class name="com.toskie.WelcomePageTestCases"/>
        </classes>
    </test>

    <test name="Login Page">
        <classes>
            <class name="com.toskie.LoginPageTestCases"/>
        </classes>
    </test>

    <test name="Profile Creation">
        <classes>
            <class name="com.toskie.ProfileCreationTestCases"/>
        </classes>
    </test>

    <test name="End-to-End Flows">
        <classes>
            <class name="com.toskie.EndToEndFlowTestCases"/>
        </classes>
    </test>

</suite>
