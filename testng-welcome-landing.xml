<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Dedicated suite: run ONLY WelcomeToToskieLandingTestCase.
     Execute: mvn clean test -Dsuite.xml.file=testng-welcome-landing.xml -->
<suite name="Welcome Landing Suite" parallel="none" thread-count="1" verbose="2">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Welcome Landing Test">
        <classes>
            <class name="com.toskie.WelcomeToToskieLandingTestCase"/>
        </classes>
    </test>

</suite>
