<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  MASTER SUITE — runs the entire test catalogue across all 16 modules.
  Functional/regression run in parallel by methods (4 threads).
  Security, Accessibility, Performance and E2E run sequentially at the end
  because they make stateful, timing-sensitive, or full-journey assertions.
-->
<suite name="Toskie MASTER Suite" parallel="methods" thread-count="4" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <!-- ===== Functional / Regression (parallel) ===== -->
    <test name="Smoke">
        <classes><class name="com.toskie.tests.smoke.SmokeTests"/></classes>
    </test>
    <test name="Login">
        <classes><class name="com.toskie.tests.regression.LoginTests"/></classes>
    </test>
    <test name="Profile">
        <classes><class name="com.toskie.tests.regression.ProfileTests"/></classes>
    </test>
    <test name="Home">
        <classes><class name="com.toskie.tests.regression.HomeTests"/></classes>
    </test>
    <test name="Search">
        <classes><class name="com.toskie.tests.regression.SearchTests"/></classes>
    </test>
    <test name="Booking">
        <classes><class name="com.toskie.tests.regression.BookingTests"/></classes>
    </test>
    <test name="Chat">
        <classes><class name="com.toskie.tests.regression.ChatTests"/></classes>
    </test>
    <test name="Notifications">
        <classes><class name="com.toskie.tests.regression.NotificationTests"/></classes>
    </test>
    <test name="Settings">
        <classes><class name="com.toskie.tests.regression.SettingsTests"/></classes>
    </test>
    <test name="Logout">
        <classes><class name="com.toskie.tests.regression.LogoutTests"/></classes>
    </test>
    <test name="Negative">
        <classes><class name="com.toskie.tests.negative.NegativeTests"/></classes>
    </test>
    <test name="Edge Cases">
        <classes><class name="com.toskie.tests.edge.EdgeCaseTests"/></classes>
    </test>

    <!-- ===== Non-functional &amp; API ===== -->
    <test name="API Validation">
        <classes><class name="com.toskie.tests.api.APIValidationTests"/></classes>
    </test>
    <test name="WebSocket">
        <classes><class name="com.toskie.tests.api.WebSocketTests"/></classes>
    </test>
    <test name="Security">
        <classes><class name="com.toskie.tests.security.SecurityTests"/></classes>
    </test>
    <test name="Accessibility">
        <classes><class name="com.toskie.tests.accessibility.AccessibilityTests"/></classes>
    </test>
    <test name="Performance">
        <classes><class name="com.toskie.tests.performance.PerformanceTests"/></classes>
    </test>

    <!-- ===== End-to-End journeys ===== -->
    <test name="End-to-End">
        <classes><class name="com.toskie.tests.e2e.EndToEndTests"/></classes>
    </test>

</suite>
