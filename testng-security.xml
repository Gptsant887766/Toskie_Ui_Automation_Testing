<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Security Suite: OWASP Top 10, XSS, SQLi, Auth bypass, Rate limiting. -->
<suite name="Toskie Security Suite" parallel="none" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl"  value="https://dev.app.toskie.com/"/>

    <test name="Security Tests">
        <classes>
            <class name="com.toskie.tests.security.SecurityTests"/>
        </classes>
    </test>

</suite>
